  "libraries": [],
  "components": [
    {
      "name": "AppBar",
      "group": "Apps",
      "summary": "The blue bar at the top of every screen of the three apps."
    },
    {
      "name": "AppScreens",
      "group": "Apps",
      "summary": "Three phone screens that put the app components together: counting plates in CYP EAT, the three flows of CYP FIN, the attendance list of CYP EDU."
    },
    {
      "name": "Button",
      "group": "Apps",
      "summary": "Anything a person taps to open, save, change or send."
    },
    {
      "name": "ChapterOpener",
      "group": "Report",
      "summary": "A full page on the blue ground that opens a numbered chapter."
    },
    {
      "name": "ChitengeStrip",
      "group": "Brand",
      "summary": "The zig-zag band from the app wordmarks, as a full-width strip: (24px) or with cyp-chitenge--tall (72px)."
    },
    {
      "name": "Choice",
      "group": "Apps",
      "summary": "One answer out of two or three, with every option on screen."
    },
    {
      "name": "ColourKey",
      "group": "Brand",
      "summary": "The fixed colours and icons of the project, as a legend block."
    },
    {
      "name": "DataTable",
      "group": "Report",
      "summary": "The table for annexes, for exports and for any list of figures."
    },
    {
      "name": "DocHeader",
      "group": "Templates",
      "summary": "The top of every document an app makes: the seal, the project name, the document title, and three facts about the document."
    },
    {
      "name": "DonutChart",
      "group": "Report",
      "summary": "Shares of one total by place, as a ring with a legend that carries the names and the values."
    },
    {
      "name": "Field",
      "group": "Apps",
      "summary": "One question with its answer box."
    },
    {
      "name": "FindingsBox",
      "group": "Report",
      "summary": "A tinted box for text that comes from a source outside the report narrative: an evaluation, a field visit, a meeting."
    },
    {
      "name": "IconDisc",
      "group": "Brand",
      "summary": "A line icon on a round colour fill: ... ."
    },
    {
      "name": "ListRow",
      "group": "Apps",
      "summary": "One record in a list: a child, a visit, a request, a delivery."
    },
    {
      "name": "Logo",
      "group": "Brand",
      "summary": "The project seal and the three app wordmarks, as files in the Logos asset group."
    },
    {
      "name": "MonthlySummary",
      "group": "Templates",
      "summary": "An A4 summary an app makes from its data for one period, here a month of CYP EAT."
    },
    {
      "name": "ProgressTable",
      "group": "Report",
      "summary": "The detail of one result: a framed table with one row per place, a bar for progress against target, and the current and target values."
    },
    {
      "name": "ReportCover",
      "group": "Report",
      "summary": "First page of the narrative report, A4 portrait: the blue ground with the seal on its white plate, the title in capitals, the subtitle in yellow, the date disc…"
    },
    {
      "name": "ReportPage",
      "group": "Report",
      "summary": "One A4 page of the narrative report: running head, heading, text, figures, running foot."
    },
    {
      "name": "RequestForm",
      "group": "Templates",
      "summary": "An A4 form made by an app from one record, here a payment request from CYP FIN."
    },
    {
      "name": "ResultBand",
      "group": "Report",
      "summary": "One top-level result in three parts on a row: a sentence, the result name with its icon disc, and one figure on a colour block."
    },
    {
      "name": "SectionOpener",
      "group": "Report",
      "summary": "Half a page of photo beside half a page of colour, with an icon and a name in capitals."
    },
    {
      "name": "StatTile",
      "group": "Apps",
      "summary": "One number with its name, for the home page of an app and the top of an internal template."
    },
    {
      "name": "StatusTag",
      "group": "Apps",
      "summary": "The state of one record in one or two words."
    },
    {
      "name": "Stepper",
      "group": "Apps",
      "summary": "A number changed by tapping minus and plus, for counts made on the spot: plates, people, bags."
    },
    {
      "name": "SyncBanner",
      "group": "Apps",
      "summary": "A full-width line under the app bar that says whether the work is saved and sent."
    },
    {
      "name": "TabBar",
      "group": "Apps",
      "summary": "The main pages of an app at the bottom of a phone screen."
    }
  ],
